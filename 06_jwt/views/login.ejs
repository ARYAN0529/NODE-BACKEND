<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>
<body>
    <div class="w-full h-screen bg-zinc-900 text-white">
        <h3 class="text-3xl font-bold mb-4">Login</h3>
        <form action="/login" method="post" class="flex flex-col items-center justify-center h-full">
        <input type="email" placeholder="Email" name="email" class="w-50 p-2 rounded-md mt-2 bg-zinc-400 mb-4 text-white"></input>
        <input type="password" placeholder="Password" name="password" class="w-50 p-2 rounded-md mt-2 bg-zinc-400 mb-4 text-white"></input>
        <button type="submit" class="w-30 p-2 rounded-md mt-2 bg-blue-500 text-white">Create User</button>
        </form>

    </div>


</body>
</html>